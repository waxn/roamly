# Copy this file to .env and fill in the values.
# In Portainer, set these as stack environment variables instead.

# Set to False in production
DEBUG=False

# Django secret key — generate one at: https://djecrety.ir/
SECRET_KEY=change-me-to-a-random-secret-key

# Comma-separated list of allowed hostnames (no protocol)
# Example: example.com,www.example.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of trusted origins for CSRF (include protocol)
# Example: https://example.com,https://www.example.com
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# --- Database ---
# Option A: Local PostGIS container
#   Start command: docker compose --profile local up
#   Both DATABASE_URL and POSTGRES_PASSWORD are required.
DATABASE_URL=postgis://roamly:change-me-to-a-strong-password@db:5432/roamly
POSTGRES_PASSWORD=change-me-to-a-strong-password

# Option B: Supabase
#   Start command: docker compose up  (no local db container is started)
#   Set DATABASE_URL to your Supabase connection string (Session mode, port 5432,
#   or Transaction mode, port 6543). POSTGRES_PASSWORD is not needed.
#   Make sure PostGIS is enabled in your Supabase project:
#     Dashboard → Database → Extensions → search "postgis" → Enable
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# --- Email / SMTP (optional) ---
# Used as the public base for links in emails (invite links, etc.).
SITE_URL=https://example.com
#
# Configure SMTP to turn on email features. Leave EMAIL_HOST blank to disable
# ALL email behaviour — signup/login then work exactly as before (no email
# verification, no new-device codes) and trip invites fall back to copyable
# on-screen links. When EMAIL_HOST is set:
#   • new signups must verify their email with a code before the account works
#   • signing in from a new/unrecognised device requires an emailed code
#   • trip invites can be sent by email
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=you@example.com
# EMAIL_HOST_PASSWORD=your-app-password
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# DEFAULT_FROM_EMAIL=Roamly <you@example.com>

# --- Road/subway/POI data download (optional) ---
# Overpass endpoints queried by Admin Panel -> Downloads. Requests try them in
# order, moving to the next only when one can't be reached or is too slow to
# answer, so a single dead or overloaded mirror no longer fails a whole run.
#
# You normally do NOT need to set these: the endpoint list is editable from
# Admin Panel -> Downloads, which is the better place for it (docker-compose.yml
# enumerates env vars explicitly, so adding one here alone would not reach the
# container). These are the fallback default when that field is left blank.
#
# The built-in default pool omits the official instance (overpass-api.de),
# which enforces a fair-use policy and refuses connections outright from an IP
# it has judged abusive. Add it back if your server can reach it.
# OVERPASS_URLS=https://overpass.kumi.systems/api/interpreter,https://overpass.private.coffee/api/interpreter
#
# Legacy singular setting. Still honoured — if set it is tried FIRST, ahead of
# the pool above, rather than replacing it.
# OVERPASS_URL=https://overpass-api.de/api/interpreter
