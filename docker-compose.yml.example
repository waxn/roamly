services:
  redis:
    image: redis:8-alpine
    container_name: roamly_redis
    restart: unless-stopped
    volumes:
      - ./data/redis:/data

  db:
    image: postgis/postgis:16-3.4
    container_name: roamly_db
    restart: unless-stopped
    environment:
      POSTGRES_DB: roamly
      POSTGRES_USER: roamly
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
    volumes:
      - ./data/postgres:/var/lib/postgresql/data
      - ./docker-init:/docker-entrypoint-initdb.d
    ports:
      - "5433:5432"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U roamly -d roamly"]
      interval: 10s
      timeout: 5s
      retries: 5

  web:
    build:
      context: .
      # RUN steps use the host's network directly during build, so pip install
      # resolves DNS the same way the host shell does — sidesteps whatever is
      # blocking the container bridge network from reaching the `dns:` servers
      # below (which only take effect once the container is actually running).
      network: host
    container_name: roamly_web
    restart: unless-stopped
    depends_on:
      - redis
      - db
    dns:
      - 1.1.1.1
      - 8.8.8.8
    command: >
      sh -c "python manage.py migrate --noinput &&
             python manage.py collectstatic --noinput &&
             gunicorn roamly.wsgi:application --bind 0.0.0.0:8000 --workers 3 --timeout 300 --max-requests 500 --max-requests-jitter 50"
    volumes:
      - ./staticfiles:/app/staticfiles
      - ./media:/app/media
      - ./tracker/migrations:/app/tracker/migrations
    ports:
      - "8001:8000"
    environment:
      - DEBUG=${DEBUG:-False}
      - SECRET_KEY=${SECRET_KEY}
      - DATABASE_URL=${DATABASE_URL}
      - ALLOWED_HOSTS=${ALLOWED_HOSTS:-localhost,127.0.0.1}
      - CSRF_TRUSTED_ORIGINS=${CSRF_TRUSTED_ORIGINS:-http://localhost,http://127.0.0.1}
      - REDIS_URL=redis://redis:6379/1
      # Optional email/SMTP — leave EMAIL_HOST blank to disable all email features.
      - SITE_URL=${SITE_URL:-http://localhost:8001}
      - EMAIL_HOST=${EMAIL_HOST:-}
      - EMAIL_PORT=${EMAIL_PORT:-587}
      - EMAIL_HOST_USER=${EMAIL_HOST_USER:-}
      - EMAIL_HOST_PASSWORD=${EMAIL_HOST_PASSWORD:-}
      - EMAIL_USE_TLS=${EMAIL_USE_TLS:-True}
      - EMAIL_USE_SSL=${EMAIL_USE_SSL:-False}
      - DEFAULT_FROM_EMAIL=${DEFAULT_FROM_EMAIL:-}
      # Overpass API instance for Settings -> Download Road/Subway Data.
      # Only needs setting if the official instance is unreachable/rate-limiting.
      - OVERPASS_URL=${OVERPASS_URL:-https://overpass-api.de/api/interpreter}

  # --- Optional: self-hosted Valhalla (road snapping/routing provider) ---
  # Not required — Roamly works fine with local/Mapbox/OSRM alone. Uncomment
  # this if you want Valhalla's Meili map matching (Settings -> Road Snapping
  # -> Road Data Provider -> Valhalla; UserProfile.valhalla_url already
  # defaults to http://valhalla:8002, matching this service's name+port, so
  # picking the provider needs no URL entry once this is running).
  #
  # This is the official image (ghcr.io/valhalla/valhalla-scripted) — it
  # downloads the .osm.pbf extracts named in tile_urls (space-separated) and
  # builds routing tiles itself on first start; no separate manual build step.
  # VALHALLA_TILE_URLS in .env is what to edit — Admin Panel -> Downloads ->
  # Valhalla Tiles auto-detects which US states your location history has
  # visited and shows you the exact value to paste in. The image rebuilds
  # tiles (diffed by md5 against what it built last) whenever the container
  # (re)starts, not live — so after updating .env, run
  # `sudo docker compose restart valhalla` to pick up newly added regions.
  # valhalla:
  #   image: ghcr.io/valhalla/valhalla-scripted:latest
  #   container_name: roamly_valhalla
  #   restart: unless-stopped
  #   environment:
  #     - tile_urls=${VALHALLA_TILE_URLS:-}
  #     - build_admins=True
  #     - build_time_zones=True
  #   volumes:
  #     - ./data/valhalla:/custom_files
