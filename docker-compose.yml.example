services:
  redis:
    image: redis:8-alpine
    container_name: roamly_redis
    restart: unless-stopped
    volumes:
      - ./data/redis:/data

  db:
    image: postgis/postgis:16-3.4
    container_name: roamly_db
    restart: unless-stopped
    environment:
      POSTGRES_DB: roamly
      POSTGRES_USER: roamly
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
    volumes:
      - ./data/postgres:/var/lib/postgresql/data
      - ./docker-init:/docker-entrypoint-initdb.d
    ports:
      - "5433:5432"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U roamly -d roamly"]
      interval: 10s
      timeout: 5s
      retries: 5

  web:
    build:
      context: .
      # RUN steps use the host's network directly during build, so pip install
      # resolves DNS the same way the host shell does — sidesteps whatever is
      # blocking the container bridge network from reaching the `dns:` servers
      # below (which only take effect once the container is actually running).
      network: host
    container_name: roamly_web
    restart: unless-stopped
    depends_on:
      redis:
        condition: service_started
      db:
        # `db` has a healthcheck; without waiting on it, `manage.py migrate`
        # below races Postgres startup on a cold boot.
        condition: service_healthy
    dns:
      - 1.1.1.1
      - 8.8.8.8
    command: >
      sh -c "python manage.py migrate --noinput &&
             python manage.py collectstatic --noinput &&
             gunicorn roamly.wsgi:application --bind 0.0.0.0:8000 --worker-class gthread --workers 3 --threads 8 --timeout 120 --graceful-timeout 30 --max-requests 10000 --max-requests-jitter 500"
    # Two deliberate choices here:
    #
    #   --max-requests was 500. All background work (geocoding, imports, POI
    #   matching, visit detection, backup export, the schedulers) runs in daemon
    #   threads started from apps.ready(), so recycling a worker kills whatever
    #   it was doing MID-FLIGHT. A phone pushing every 30s plus a browser polling
    #   a status endpoint reaches 500 requests in minutes, and job recovery only
    #   fires when someone polls that job's status — so an unattended run just
    #   died. 10000 keeps the leak protection the flag is for without shredding
    #   jobs several times an hour.
    #
    #   --worker-class gthread. With the default sync worker, 3 workers meant 3
    #   concurrent requests for the entire app, and a single blocking call took a
    #   third of it: mobile_download_apk streams a ~40MB APK from GitHub with a
    #   120s timeout, unauthenticated. Three of those and the site is down.
    #
    # Do NOT add --preload. apps.ready() would run in the master pre-fork,
    # threads do not survive fork(), and each module's `_scheduler_thread` guard
    # would then see a non-None object in the children and skip starting them —
    # every background job would silently stop.
    volumes:
      - ./staticfiles:/app/staticfiles
      - ./media:/app/media
      - ./tracker/migrations:/app/tracker/migrations
    ports:
      - "8001:8000"
    healthcheck:
      test: ["CMD-SHELL", "python -c \"import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/healthz/', timeout=5).status==200 else 1)\""]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 60s
    environment:
      - DEBUG=${DEBUG:-False}
      - SECRET_KEY=${SECRET_KEY}
      - DATABASE_URL=${DATABASE_URL}
      - ALLOWED_HOSTS=${ALLOWED_HOSTS:-localhost,127.0.0.1}
      - CSRF_TRUSTED_ORIGINS=${CSRF_TRUSTED_ORIGINS:-http://localhost,http://127.0.0.1}
      # How many reverse proxies sit in front of this container. Decides which
      # X-Forwarded-For entry is trusted as the client IP, which is what every
      # auth rate limit keys on. See .env.example.
      - TRUSTED_PROXY_COUNT=${TRUSTED_PROXY_COUNT:-1}
      # See .env.example — HSTS is remembered by browsers, so it is opt-in.
      - HSTS_SECONDS=${HSTS_SECONDS:-0}
      - SSL_REDIRECT=${SSL_REDIRECT:-False}
      - CSP_ENFORCE=${CSP_ENFORCE:-False}
      - CSP_EXTRA_HOSTS=${CSP_EXTRA_HOSTS:-}
      - REDIS_URL=redis://redis:6379/1
      # Optional email/SMTP — leave EMAIL_HOST blank to disable all email features.
      - SITE_URL=${SITE_URL:-http://localhost:8001}
      - EMAIL_HOST=${EMAIL_HOST:-}
      - EMAIL_PORT=${EMAIL_PORT:-587}
      - EMAIL_HOST_USER=${EMAIL_HOST_USER:-}
      - EMAIL_HOST_PASSWORD=${EMAIL_HOST_PASSWORD:-}
      - EMAIL_USE_TLS=${EMAIL_USE_TLS:-True}
      - EMAIL_USE_SSL=${EMAIL_USE_SSL:-False}
      - DEFAULT_FROM_EMAIL=${DEFAULT_FROM_EMAIL:-}
      # Overpass endpoints for Admin Panel -> Downloads. Normally left unset:
      # the endpoint list is editable in Admin Panel -> Downloads, and these are
      # only the fallback when that field is blank. OVERPASS_URL (singular) is
      # the legacy name and, if set, is tried first ahead of the pool.
      - OVERPASS_URLS=${OVERPASS_URLS:-}
      - OVERPASS_URL=${OVERPASS_URL:-}

