<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Install a downloaded APK update (in-app updater) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Location -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Background location — requested at runtime AFTER fine location is granted -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Foreground service (tracking) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Auto-start on boot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Battery optimisation exemption -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Doze-piercing exact alarms (heartbeat). USE_EXACT_ALARM is auto-granted;
         SCHEDULE_EXACT_ALARM is the user-revocable fallback we check at runtime. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- Notifications (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Wake lock for upload worker -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Health Connect (read-only; Roamly never writes back).
         READ_HEALTH_DATA_HISTORY is load-bearing: without it Health Connect only
         ever returns the trailing 30 days, so a deeper backfill silently comes
         back empty. READ_HEALTH_DATA_IN_BACKGROUND is equally load-bearing:
         without it reads only succeed while the app is foregrounded, which
         defeats the periodic sync worker entirely. Both are requested
         separately at runtime as optional upgrades, so declining either
         degrades the feature rather than breaking it. -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_TOTAL_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_HISTORY" />
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND" />

    <!-- Package visibility for the Health Connect APK on Android 13 and below,
         where it is an installable app rather than part of the platform. -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application
        android:name=".RoamlyApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Roamly"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Roamly">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Location tracking foreground service -->
        <service
            android:name=".tracking.LocationTrackingService"
            android:exported="false"
            android:foregroundServiceType="location"
            android:stopWithTask="false" />

        <!-- Restart tracking after reboot -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </receiver>

        <!-- Self-resurrection: a standalone receiver that restarts the tracking
             service when it is destroyed/killed while the user wants it on. -->
        <receiver
            android:name=".receiver.RestarterReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.roamly.RESTART_TRACKING" />
            </intent-filter>
        </receiver>

        <!-- Doze-piercing heartbeat alarm: verifies the service is alive and
             re-arms itself, even in deep Doze. -->
        <receiver
            android:name=".receiver.TrackingAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.roamly.TRACKING_HEARTBEAT" />
            </intent-filter>
        </receiver>

        <!-- Disable default WorkManager initializer so Hilt can own it -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>

    
        <!-- Health Connect permission rationale. Health Connect refuses to show
             its grant sheet unless the app declares a rationale entry point, and
             it needs two: the action below for Android 13 and earlier (where
             Health Connect is an installable APK), and the activity-alias for
             Android 14+ (where it lives in the platform). Both target the same
             one-screen activity. -->
        <activity
            android:name=".health.HealthPermissionsRationaleActivity"
            android:exported="true"
            android:theme="@style/Theme.Roamly">
            <intent-filter>
                <action android:name="androidx.health.connect.action.SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".health.HealthPermissionsRationaleActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

    </application>

</manifest>
