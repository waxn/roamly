<?xml version="1.0" encoding="utf-8"?>
<!-- The Roamly logo mark (same as the website favicon), inset so the whole mark
     stays inside the adaptive-icon safe zone and is never clipped by the mask. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="22dp"
        android:top="22dp"
        android:right="22dp"
        android:bottom="22dp">
        <bitmap
            android:src="@drawable/roamly_favicon"
            android:gravity="fill" />
    </item>
</layer-list>
