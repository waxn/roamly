<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- ── Server connection ──────────────────────────────────────────── -->
    <PreferenceCategory android:title="Server">

        <EditTextPreference
            android:key="server_url"
            android:title="Server URL"
            android:summary="e.g. https://your-roamly.example.com"
            android:hint="https://roamly.example.com"
            android:inputType="textUri"
            app:useSimpleSummaryProvider="true" />

        <EditTextPreference
            android:key="api_key"
            android:title="API Key"
            android:summary="64-character hex key from Roamly settings"
            android:inputType="textPassword"
            app:useSimpleSummaryProvider="false" />

        <EditTextPreference
            android:key="device_id"
            android:title="Device Name"
            android:summary="Identifies this device in Roamly (e.g. Pixel9Pro)"
            android:inputType="textNoSuggestions"
            app:useSimpleSummaryProvider="true" />

    </PreferenceCategory>

    <!-- ── Tracking behaviour ─────────────────────────────────────────── -->
    <PreferenceCategory android:title="Tracking">

        <ListPreference
            android:key="tracking_mode"
            android:title="Tracking Mode"
            android:summary="Trade-off between accuracy and battery life"
            android:entries="@array/tracking_mode_entries"
            android:entryValues="@array/tracking_mode_values"
            android:defaultValue="balanced"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            android:key="max_accuracy_m"
            android:title="Max Accuracy Threshold"
            android:summary="Reject GPS fixes worse than this (metres)"
            android:entries="@array/accuracy_entries"
            android:entryValues="@array/accuracy_values"
            android:defaultValue="100"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            android:key="min_displacement_m"
            android:title="Minimum Movement"
            android:summary="Skip point if moved less than this distance"
            android:entries="@array/displacement_entries"
            android:entryValues="@array/displacement_values"
            android:defaultValue="5"
            app:useSimpleSummaryProvider="true" />

    </PreferenceCategory>

    <!-- ── Upload / sync ──────────────────────────────────────────────── -->
    <PreferenceCategory android:title="Sync">

        <ListPreference
            android:key="prune_days"
            android:title="Keep synced points for"
            android:summary="How long to keep synced points in local cache"
            android:entries="@array/prune_days_entries"
            android:entryValues="@array/prune_days_values"
            android:defaultValue="7"
            app:useSimpleSummaryProvider="true" />

        <Preference
            android:key="clear_cache"
            android:title="Clear local cache"
            android:summary="Delete all locally stored points" />

    </PreferenceCategory>

    <!-- ── About ──────────────────────────────────────────────────────── -->
    <PreferenceCategory android:title="About">

        <Preference
            android:key="app_version"
            android:title="Version"
            android:summary="1.0.0"
            android:selectable="false" />

    </PreferenceCategory>

</PreferenceScreen>
